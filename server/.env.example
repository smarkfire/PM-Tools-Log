# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=logadmin
DB_PASSWORD=logadmin123
DB_NAME=logdb

# JWT 密钥（生产环境请务必修改为随机长字符串）
JWT_SECRET=log-management-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# AI 配置 - 通义千问（DashScope OpenAI 兼容模式）
# 留空则使用管理员在【系统设置】中配置的系统 Key，或用户在【个人设置】中配置的个人 Key
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# AI 配置 - DeepSeek（OpenAI 兼容模式）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# AI 对话上下文最大日志条数
AI_CONTEXT_MAX_LOGS=50
